# Copy to .env and fill in. Never commit .env (it is gitignored).

# mod.io OAuth2 token: https://mod.io/me/access -> OAuth2 -> create client -> generate token
ACCESS_TOKEN=

# Steam (Windows):
#   USER_PROFILE=C:/Program Files (x86)/Steam/userdata/<STEAM_ID>/1465360/remote/user_profile.cfg
#   MODS_DIR=C:/Users/<USER>/Documents/My Games/SnowRunner/base/Mods/.modio/mods
#
# Lutris / Wine (Linux), non-Steam build:
#   USER_PROFILE=~/Games/snowrunner/drive_c/users/Public/Documents/Steam/RUNE/1465360/remote/user_profile.cfg
#   MODS_DIR=~/Games/snowrunner/drive_c/users/<USER>/Documents/My Games/SnowRunner/base/Mods/.modio/mods
USER_PROFILE=
MODS_DIR=
